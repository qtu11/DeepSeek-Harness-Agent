# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DEEPSEEK HARNESS & DS2API
# ==============================================================================

# Cổng mạng chuyên dụng (Tránh xung đột cổng mặc định)
PORT=23080
DS2API_PORT=25001

# ------------------------------------------------------------------------------
# LỰA CHỌN 1: Sử dụng tài khoản DeepSeek Web miễn phí (qua ds2api)
# ------------------------------------------------------------------------------
DS2API_ENABLED=true

# Cách A: Điền User Token lấy từ chat.deepseek.com (F12 -> Application -> LocalStorage / Network)
DS_USER_TOKEN=your_user_token_here

# Cách B: Hoặc sử dụng Email & Mật khẩu đăng nhập DeepSeek
# DS_EMAIL=your_email@example.com
# DS_PASSWORD=your_password_here

# ------------------------------------------------------------------------------
# LỰA CHỌN 2: Sử dụng DeepSeek Official API Key
# ------------------------------------------------------------------------------
# DEEPSEEK_API_KEY=sk-your-official-deepseek-api-key
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# ------------------------------------------------------------------------------
# LỰA CHỌN MÔ HÌNH MẶC ĐỊNH
# ------------------------------------------------------------------------------
# deepseek-chat | deepseek-reasoner | deepseek-v4-flash | deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-v4-pro
DS_EMAIL=email_cua_ban@example.com
DS_PASSWORD=mat_khau_tai_khoan